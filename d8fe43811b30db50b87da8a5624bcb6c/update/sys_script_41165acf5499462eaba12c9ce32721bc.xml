        <script><![CDATA[(function executeRule(current, previous) {
    var gr = new GlideRecord('x_2307780_sentin_0_patient');
    gr.addQuery('patient_number', 'STARTSWITH', 'PAT');
    gr.orderByDesc('patient_number');
    gr.setLimit(1);
    gr.query();

    var nextNum = 100000;
    if (gr.next()) {
        var lastNum = parseInt(gr.getValue('patient_number').replace('PAT', ''), 10);
        if (!isNaN(lastNum)) {
            nextNum = lastNum + 1;
        }
    }

    var padded = ('0000000' + nextNum).slice(-7);
    current.setValue('patient_number', 'PAT' + padded);
})(current, previous);
]]></script>
