        <script><![CDATA[(function executeRule(current, previous) {
    // filterCondition already limits execution to placement_status changing to 'open'
    var errors = [];
    if (!current.getValue('nursing_group')) {
        errors.push('Nursing Group');
    }
    if (!current.getValue('housekeeping_group')) {
        errors.push('Housekeeping Group');
    }
    if (errors.length > 0) {
        gs.addErrorMessage(
            'The following groups must be assigned before opening a ward for placement: ' +
            errors.join(', ')
        );
        current.setAbortAction(true);
    }
})(current, previous);
]]></script>
